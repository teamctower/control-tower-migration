# ============================================
# Control Tower Migration - Environment Variables
# ============================================
# Copy this file to .env and update with your actual credentials
# IMPORTANT: Never commit the .env file to version control!

# API Configuration
# -----------------
# Base URL for the Control Tower API
API_BASE_URL=http://localhost:4000

# Authentication Credentials
# --------------------------
# REQUIRED: Your Control Tower account credentials
API_USERNAME=
API_PASSWORD=
API_DEVICE_NAME=

# Device Configuration
# --------------------
# REQUIRED: Device ID for data stream uploads
API_DEVICE_ID=
